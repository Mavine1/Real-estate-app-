{
  "expo": {
    "name": "Baraka Homes",
    "slug": "baraka-homes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/baraka-app-icon.png",
    "scheme": "barakahomes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barakahomes.app"
    },
    "android": {
      "package": "com.barakahomes.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/baraka-logo-mark-v2.png",
        "backgroundColor": "#F4F7FF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/baraka-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Baraka Homes to choose your profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/baraka-logo-mark-v2.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4F7FF"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Rubik-Bold.ttf",
            "./assets/fonts/Rubik-ExtraBold.ttf",
            "./assets/fonts/Rubik-Light.ttf",
            "./assets/fonts/Rubik-Medium.ttf",
            "./assets/fonts/Rubik-Regular.ttf",
            "./assets/fonts/Rubik-SemiBold.ttf"
          ]
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
